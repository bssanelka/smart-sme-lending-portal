    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Credit Cabinet: production",
    "command": "npm.cmd run build && npm.cmd start",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
