{
  "name": "smart-credit-cabinet",
  "private": true,
  "version": "1.0.2",
  "description": "End-to-end lending portal for entrepreneurs and bank analysts",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,SERVER -c red,blue \"cross-env PORT=3000 npm run dev:web\" \"cross-env PORT=3001 npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build:web": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node20 --external:better-sqlite3 --outfile=dist-server/index.cjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run typecheck:server && npm run build:server",
    "start": "node dist-server/index.cjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run tests --passWithNoTests",
    "test:watch": "vitest tests",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@scalar/hono-api-reference": "^0.9.48",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^5.0.5"
  }
}
